# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PORT
PORT=3000

# MongoDB connection string
MONGODB_URI="mongodb://localhost:27017/cinema_db"

# Secret key for JWT authentication tokens
JWT_SECRET="cinema_jwt_secret_key_2026_super_secure"

# TMDB Movie Database API Key (optional fallback to built-in mock/cached data if unprovided)
TMDB_API_KEY=""

# Admin seed credentials
ADMIN_EMAIL="admin@cinema.com"
ADMIN_PASSWORD="admin123"

# Storage Provider configuration (Cloudinary, AWS S3, Cloudflare R2, Supabase, Firebase)
STORAGE_PROVIDER="s3"
STORAGE_BUCKET="cinema-movie-vault"
STORAGE_REGION="us-east-1"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# Client URL
CLIENT_URL="http://localhost:3000"


