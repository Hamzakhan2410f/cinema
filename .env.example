# ==========================================
# VERCEL ENVIRONMENT VARIABLES (Frontend)
# ==========================================
# Point to your deployed Express backend with /api suffix (or root domain)
VITE_API_URL=https://your-backend.onrender.com/api

# ==========================================
# RENDER / RAILWAY ENVIRONMENT VARIABLES (Backend)
# ==========================================
PORT=3000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/cinema_db?retryWrites=true&w=majority
JWT_SECRET=cinema_jwt_secret_key_2026_super_secure
CLIENT_URL=https://your-frontend.vercel.app
ADMIN_EMAIL=admin
ADMIN_PASSWORD=admin123
TMDB_API_KEY=

# Storage Provider (Optional S3/Cloudinary/R2 configuration)
STORAGE_PROVIDER=s3
STORAGE_BUCKET=
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=


